FROM mcr.microsoft.com/playwright:v1.49.0-jammy
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY server/package.hiflow-sync.json ./package.json
RUN npm install --omit=dev
COPY server/hiflow-sync.cjs ./hiflow-sync.cjs
COPY server/hiflow-vendor ./hiflow-vendor
EXPOSE 8080
CMD ["node", "hiflow-sync.cjs"]
